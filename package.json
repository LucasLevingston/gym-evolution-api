{
  "name": "gym-evolution-api",
  "description": "",
  "version": "1.0.0",
  "main": "server.ts",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "tsx --env-file .env --watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "dotenv -e .env.test -- vitest run --reporter=verbose",
    "test:coverage": "dotenv -e .env.test -- vitest run --coverage",
    "test:watch": "dotenv -e .env.test -- vitest watch",
    "test:ui": "dotenv -e .env.test -- vitest --ui",
    "seed": "prisma generate && tsx --env-file .env prisma/seed.ts",
    "seed:local": "prisma generate && tsx --env-file .env.seed prisma/seed.ts",
    "seed:test": "tsx --env-file .env.test prisma/seed.ts",
    "setup:hooks": "bash scripts/setup-hooks.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.779.0",
    "@edge-runtime/vm": "latest",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "latest",
    "@fastify/jwt": "latest",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@fastify/swagger": "latest",
    "@fastify/swagger-ui": "latest",
    "@google-cloud/local-auth": "^2.1.0",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "latest",
    "@types/debug": "latest",
    "@types/node": "latest",
    "@vitest/browser": "latest",
    "@vitest/ui": "latest",
    "abacatepay-nodejs-sdk": "^1.1.1",
    "autoprefixer": "^10.4.20",
    "bcrypt": "^5.1.1",
    "bcryptjs": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "^4.1.0",
    "fastify": "latest",
    "fastify-type-provider-zod": "latest",
    "fatsecret": "^1.0.2",
    "google-auth-library": "^9.15.1",
    "googleapis": "^105.0.0",
    "happy-dom": "latest",
    "input-otp": "1.4.1",
    "jsdom": "latest",
    "jsonwebtoken": "latest",
    "mercadopago": "^2.3.0",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^6.10.0",
    "path": "latest",
    "prisma": "latest",
    "recharts": "2.15.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.3",
    "typescript": "latest",
    "vaul": "^0.9.6",
    "vitest": "latest",
